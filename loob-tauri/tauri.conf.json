{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "loob",
  "version": "0.1.0",
  "identifier": "dev.loob.playlist",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "loob — local playlist smoother",
        "width": 760,
        "height": 820,
        "minWidth": 520,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; media-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
